<Window x:Class="TTS.KioskDisplay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TTS Kiosk" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Text-to-Speech Kiosk" 
                   FontSize="{DynamicResource GlobalFontSize}"
                   FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Main Text Input -->
        <TextBox x:Name="MainTextInput" Grid.Row="1" 
                 Text="{Binding CurrentText, UpdateSourceTrigger=PropertyChanged}"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 FontSize="{DynamicResource GlobalFontSize}"
                 Margin="0,0,0,20"/>

        <!-- Voice Settings -->
        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,0,0,20">
            <Label Content="Voice:" FontSize="{DynamicResource GlobalFontSize}"/>
            <ComboBox x:Name="VoiceSelector" Margin="0,5,0,15"/>
            
            <Label Content="Speed:" FontSize="{DynamicResource GlobalFontSize}"/>
            <Slider x:Name="SpeedSlider" Minimum="-10" Maximum="10" Value="0" 
                    TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,5,0,15"/>
            
            <Label Content="Volume:" FontSize="{DynamicResource GlobalFontSize}"/>
            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="100" 
                    TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,5,0,15"/>
        </StackPanel>

        <!-- Control Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Button x:Name="VocalizeButton" Content="Vocalize" 
                    Command="{Binding VocalizeCommand}"
                    Width="100" Height="40" Margin="5"
                    FontSize="{DynamicResource GlobalFontSize}"/>
            <Button x:Name="HaltButton" Content="Halt" 
                    Command="{Binding HaltCommand}"
                    Width="100" Height="40" Margin="5"
                    FontSize="{DynamicResource GlobalFontSize}"/>
            <Button x:Name="ClearButton" Content="Clear" 
                    Command="{Binding ClearCommand}"
                    Width="100" Height="40" Margin="5"
                    FontSize="{DynamicResource GlobalFontSize}"/>
        </StackPanel>

        <!-- Accessibility Controls -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="HighContrastToggle" Content="High Contrast" 
                    Width="120" Height="35" Margin="5"
                    FontSize="{DynamicResource GlobalFontSize}"/>
            <Button x:Name="LargeFontToggle" Content="Large Font" 
                    Width="120" Height="35" Margin="5"
                    FontSize="{DynamicResource GlobalFontSize}"/>
            <TextBlock x:Name="LiveRegionAnnouncer" 
                       Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>
